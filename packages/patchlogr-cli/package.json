{
    "name": "@patchlogr/cli",
    "version": "0.0.0",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
        "build:js": "node ./esbuild.mjs",
        "build": "yarn clean && yarn build:types && yarn build:js",
        "test": "vitest",
        "lint": "eslint ."
    },
    "dependencies": {
        "@patchlogr/core": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "24",
        "esbuild": "^0.27.2",
        "typescript": "^5.9.3",
        "vitest": "^4.0.16"
    }
}
