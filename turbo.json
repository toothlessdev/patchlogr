{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["src/**", "package.json", "tsconfig.json"],
            "outputs": ["dist/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": ["^build"],
            "inputs": [
                "src/**",
                "test/**",
                "vitest.config.*",
                "package.json",
                "tsconfig.json"
            ],
            "outputs": [".coverage/**"]
        },
        "test:coverage": {
            "dependsOn": ["^build"],
            "inputs": [
                "src/**",
                "test/**",
                "vitest.config.*",
                "package.json",
                "tsconfig.json"
            ],
            "outputs": [".coverage/**"]
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "inputs": ["src/**", "package.json", "tsconfig.json"],
            "outputs": []
        },
        "lint": {
            "inputs": ["src/**", "package.json"],
            "outputs": []
        },
        "lint:fix": {
            "inputs": ["src/**", "package.json"],
            "outputs": []
        },
        "clean": {
            "cache": false,
            "outputs": []
        }
    }
}
